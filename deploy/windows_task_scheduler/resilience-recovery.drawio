<mxfile host="app.diagrams.net" modified="2026-11-10T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="recovery-architecture" name="Архитектура восстановления">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Устойчивость и аварийное восстановление&#xa;Цели: RTO 30–120 мин · RPO ≤ 4 ч" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="310" y="25" width="900" height="70" as="geometry"/></mxCell>
        <mxCell id="primary" value="Основная площадка · Провайдер A&#xa;Рабочие сервисы компании&#xa;Приложения · БД · интеграции&#xa;Планировщик задач и рабочие учётные записи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="390" height="210" as="geometry"/></mxCell>
        <mxCell id="standby" value="Резервная площадка · Провайдер B&#xa;Подготовленные сети, серверы и версии ПО&#xa;Данные реплицируются или регулярно восстанавливаются&#xa;До переключения запись и расписания выключены" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="backup" value="Отдельное хранилище backup&#xa;Другой аккаунт / отдельные права&#xa;Шифрование · неизменяемые поколения&#xa;Копии БД и файлов · тест восстановления" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="350" height="210" as="geometry"/></mxCell>
        <mxCell id="security" value="Общий контур безопасности и управления&#xa;IAM / SSO + MFA · роли с минимальными правами&#xa;Vault: секреты, ротация, аварийный доступ&#xa;Аудит в независимое централизованное хранилище&#xa;Мониторинг доступности, backup и возраста данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="250" y="475" width="900" height="190" as="geometry"/></mxCell>
        <mxCell id="runbook" value="Полуавтоматическое переключение&#xa;1. Обнаружить сбой и объявить аварию&#xa;2. Проверить последнюю доверенную копию и доступы&#xa;3. Остановить/изолировать запись на старой площадке&#xa;4. Поднять БД и приложения на резерве&#xa;5. Проверить бизнес-операцию, переключить DNS/маршрутизацию&#xa;6. Включить расписания на резерве; зафиксировать время и потери" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="760" width="660" height="205" as="geometry"/></mxCell>
        <mxCell id="edge-repl" value="Репликация / доставка данных" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2f5597;fontSize=13;" edge="1" parent="1" source="primary" target="standby"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-backup1" value="Зашифрованные копии" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#bf9000;fontSize=13;" edge="1" parent="1" source="primary" target="backup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-backup2" value="Восстановление из доверенной точки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#bf9000;fontSize=13;" edge="1" parent="1" source="backup" target="standby"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-security1" value="Доступ и аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;dashed=1;strokeColor=#9673a6;fontSize=13;" edge="1" parent="1" source="security" target="primary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-security2" value="Доступ и аудит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;dashed=1;strokeColor=#9673a6;fontSize=13;" edge="1" parent="1" source="security" target="standby"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge-run" value="Аварийная процедура" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=13;" edge="1" parent="1" source="security" target="runbook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="Важно: реплика может перенести повреждение или шифрование. Для инцидента безопасности сначала изолировать системы, выбрать чистую точку восстановления, сменить скомпрометированные доступы и только затем открывать резерв пользователям." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="745" width="290" height="220" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
