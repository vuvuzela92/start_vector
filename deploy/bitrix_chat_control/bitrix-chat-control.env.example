# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# OpenAI
OPENAI_API_KEY=

# Telegram
WB_FBS_TG_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_SERVICE_CHAT_IDS=
TELEGRAM_REQUEST_TIMEOUT_SECONDS=20

# Bitrix runtime
BITRIX_RUNTIME_TRANSPORT=rest
BITRIX_REST_PORTAL_URL=
BITRIX_REST_AUTH_MODE=webhook
BITRIX_REST_WEBHOOK_USER_ID=
BITRIX_REST_WEBHOOK_TOKEN=
BITRIX_REST_ACCESS_TOKEN=
BITRIX_REST_REQUEST_TIMEOUT_SECONDS=30
BITRIX_REST_MAX_RETRIES=3

# Bitrix chat control
BITRIX_CHAT_DISCOVERY_ENABLED=true
BITRIX_CHAT_DISCOVERY_PAGE_LIMIT=200
BITRIX_MESSAGES_LIMIT=200
BITRIX_ANALYSIS_MODEL=gpt-4.1-mini
BITRIX_ADMIN_NOTIFY_ENABLED=true

# Reports
BITRIX_DAILY_REPORT_HOUR_MOSCOW=9
BITRIX_WEEKLY_REPORT_WEEKDAY=0
