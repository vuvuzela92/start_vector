[Unit]
Description=Start Vector Bitrix Chat Control Daily Report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vector
Group=vector
WorkingDirectory=/opt/start_vector
EnvironmentFile=/etc/start-vector/bitrix-chat-control.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/start_vector/.venv/bin/python main.py daily_report

[Install]
WantedBy=multi-user.target
