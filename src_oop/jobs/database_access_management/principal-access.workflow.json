  "edges": [
    { "id": "open-bot", "from": "manager", "to": "bot", "role": "main" },
    { "id": "choose-principal", "from": "bot", "to": "principal", "label": "создать или изменить", "role": "main" },
    { "id": "human-identity", "from": "principal", "to": "human", "label": "сотрудник", "role": "main", "variant": "emphasis" },
    { "id": "service-identity", "from": "principal", "to": "service_account", "label": "микросервис", "role": "branch", "variant": "emphasis" },
    { "id": "human-role", "from": "human", "to": "role", "label": "назначить роль", "role": "main", "variant": "security" },
    { "id": "service-role", "from": "service_account", "to": "role", "label": "назначить роль", "role": "branch", "variant": "security" },
    { "id": "apply-role", "from": "role", "to": "databases", "label": "применить права", "role": "main", "variant": "emphasis" },
    { "id": "store-secret", "from": "service_account", "to": "vault", "label": "передать секрет", "role": "async", "variant": "security" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Правило учётных записей",
      "items": [
        "Не использовать одну общую учётную запись для всех микросервисов",
        "Разделять service account по сервису и среде: prod, stage, dev",
        "Роли можно переиспользовать между людьми и сервисами"
      ]
    },
    {
      "dot": "rose",
      "title": "Секреты и аудит",
      "items": [
        "Пароли и ключи не передаются через Telegram",
        "Секрет хранится в Vault или аналогичном менеджере секретов",
        "Для service account фиксируются владелец, команда и среда"
      ]
    }
  ]
}
