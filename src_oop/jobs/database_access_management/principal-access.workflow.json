{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Выдача доступа человеку и микросервису",
    "quality_profile": "showcase",
    "output": "src_oop/jobs/database_access_management/principal-access.workflow.html"
  },
  "lanes": [
    { "id": "manager", "label": "Руководитель и Telegram-бот" },
    { "id": "service", "label": "Сервис управления доступами" },
