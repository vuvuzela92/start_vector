  ],
  "phases": [
    { "id": "select", "label": "Выбор", "fromCol": 0, "toCol": 2 },
    { "id": "identity", "label": "Учётная запись", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "access", "label": "Роль и доступ", "fromCol": 4, "toCol": 4, "variant": "security" }
  ],
  "mainPath": ["manager", "bot", "principal", "human", "role", "databases"],
  "semanticChecks": {
    "allowedRoots": ["manager"],
    "allowedTerminals": ["databases", "vault"],
    "requiredPaths": [
      { "from": "manager", "to": "databases" },
      { "from": "service_account", "to": "vault" }
    ]
  },
  "nodes": [
    {
      "id": "manager",
      "lane": "manager",
      "col": 0,
      "type": "external",
      "label": "Руководитель",
      "width": 138
    },
    {
      "id": "bot",
      "lane": "manager",
      "col": 1,
      "type": "security",
      "label": "Telegram-бот",
      "sublabel": "проверка ID",
      "width": 146
    },
    {
      "id": "principal",
      "lane": "manager",
      "col": 2,
      "type": "frontend",
      "label": "Тип субъекта",
      "sublabel": "сотрудник или микросервис",
      "width": 156
    },
    {
      "id": "human",
      "lane": "service",
      "col": 3,
      "type": "security",
      "label": "Личный логин",
      "sublabel": "один сотрудник — одна учётная запись",
      "width": 168
    },
    {
      "id": "service_account",
      "lane": "infrastructure",
      "col": 3,
      "type": "backend",
      "label": "Service account",
