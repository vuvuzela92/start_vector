      "width": 164
    },
    {
      "id": "role",
      "lane": "service",
      "col": 4,
      "type": "security",
      "label": "Роль доступа",
      "sublabel": "уровень прав",
      "width": 172
    },
    {
      "id": "databases",
      "lane": "infrastructure",
      "col": 4,
      "type": "database",
      "label": "Целевая СУБД",
      "sublabel": "PostgreSQL / ClickHouse",
      "width": 154
    },
    {
      "id": "vault",
      "lane": "infrastructure",
      "col": 4,
      "type": "security",
      "label": "Хранилище секретов",
      "sublabel": "секрет и ротация",
      "width": 160,
      "yOffset": 88
    }
